  "fixed_sql": [
    {
      "name": "exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "programs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"programs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "workouts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workouts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"program_id\" INTEGER NOT NULL REFERENCES programs (id), \"name\" TEXT NOT NULL, \"sets\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "workout_exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"workout_id\" INTEGER NOT NULL REFERENCES workouts (id) ON DELETE CASCADE, \"exercise_id\" INTEGER NOT NULL REFERENCES exercises (id) ON DELETE RESTRICT, \"reps\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "workout_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"workout_id\" INTEGER NOT NULL REFERENCES workouts (id) ON DELETE RESTRICT, \"program_id\" INTEGER NOT NULL REFERENCES programs (id) ON DELETE RESTRICT, \"started_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "session_circuits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"session_circuits\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES workout_sessions (id) ON DELETE CASCADE, \"circuit_number\" INTEGER NOT NULL, \"started_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "session_exercise_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"session_exercise_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"circuit_id\" INTEGER NOT NULL REFERENCES session_circuits (id) ON DELETE CASCADE, \"exercise_id\" INTEGER NOT NULL REFERENCES exercises (id) ON DELETE RESTRICT, \"position\" INTEGER NOT NULL, \"target_reps\" INTEGER NOT NULL, \"actual_reps\" INTEGER NULL, \"started_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL);"
        }
      ]
    }
  ]
